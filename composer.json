{
    "name": "ipedis/security-file-bundle",
    "description": "Symfony bundle for file security",
    "type": "library",
    "authors": [
        {
            "name": "melchior",
            "email": "melchior@ipedis.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.2",
        "symfony/http-kernel": "^7.0",
        "symfony/dependency-injection": "^7.0",
        "symfony/config": "^7.0",
        "ipedis/file-sanitizer": "^2.1.0",
        "symfony/options-resolver": "^7.0",
        "symfony/yaml": "^7.0",
        "selective/archive-bomb-scanner": "^2.0",
        "ipedis/validation-handler": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Ipedis\\SecurityFileBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "rector/rector": "^2.3",
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1",
        "laravel/pint": "^1.27",
        "phpstan/phpstan-strict-rules": "^2.0",
        "symfony/phpunit-bridge": "6.0.*"
    },
    "extra": {
        "symfony": {
            "endpoint": [
                "flex://defaults"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage",
        "phpstan": "phpstan analyse --memory-limit 2024M",
        "pint": "pint",
        "pint:check": "pint --test",
        "rector": "rector process",
        "rector:check": "rector process --dry-run",
        "qa": [
            "@rector",
            "@pint",
            "@phpstan",
            "@test"
        ]
    }
}
